# Copy this to scribe.env and fill in your own values.
# scribe.env itself is gitignored — never commit your real journal path
# or API key.

SCRIBE_JOURNAL_ROOT=/path/to/your/journal
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Your own phase/folder names, comma-separated — this tool doesn't assume
# any one study plan or roadmap. Example for a different setup entirely:
# SCRIBE_PHASES=Inbox,Networking,Web-Security,Pentesting,CTFs,Reports
# Leave unset to use the H4CKER-roadmap defaults (00-Inbox..10-References).
SCRIBE_PHASES=

# Leave blank unless you're using the Anthropic fallback:
ANTHROPIC_API_KEY=
